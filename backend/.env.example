# --- языковая модель -------------------------------------------------------
# Провайдер: yandex | gigachat | openai | ollama | mock
LLM_PROVIDER=yandex

# Yandex Cloud AI Studio, протокол OpenAI
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_FOLDER_ID=

# Доступны также qwen3.6-35b-a3b и qwen3-235b-a22b-fp8.
# YandexGPT-5-Pro выбрана за скорость: 0.9 с против 3 и 28 секунд,
# при лучшем качестве русского языка.
LLM_MODEL=yandexgpt-5-pro

# auto — вызов инструментов через tools, json — запасной путь через JSON-схему
LLM_TOOLS=auto
LLM_TIMEOUT=60

# При ошибке живой модели отдавать ответ заглушки вместо падения
LLM_FALLBACK_TO_MOCK=true

# --- поиск по базе знаний ---------------------------------------------------
# auto | yandex | gigachat | ollama | none
# Без эмбеддингов поиск остаётся лексическим и продолжает работать
EMBEDDINGS_PROVIDER=auto

# --- проверка ответа --------------------------------------------------------
# Второй слой проверки отдельным вызовом модели
VERIFY_WITH_MODEL=true

# Проверенный ответ уходит пользователю сам. Человек подключается только там,
# где проверка что-то нашла. Выключите, если нужна виза оператора на каждом.
AUTO_SEND=true

# --- локальная модель как запасной путь -------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
