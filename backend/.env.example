# Провайдер языковой модели: openai | gigachat | mock
# mock работает без ключа и нужен для разработки и как страховка на защите
LLM_PROVIDER=mock

# Выдают организаторы хакатона
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# auto — вызов инструментов через tools, json — запасной путь через JSON-схему
LLM_TOOLS=auto

# Таймаут одного обращения к модели, секунды
LLM_TIMEOUT=30

# При ошибке живой модели отдавать ответ заглушки вместо падения
LLM_FALLBACK_TO_MOCK=true
