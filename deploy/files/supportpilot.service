[Unit]
Description=SupportPilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pilot
WorkingDirectory=/opt/supportpilot/app/backend
ExecStart=/opt/supportpilot/app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
